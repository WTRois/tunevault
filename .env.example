# TuneVault Environment Configuration Example
# Copy to `.env` and adjust. All variables are optional — the defaults below
# match blueprint §38. Docker Compose (§30) sets its own values inline.

# --- Core ---
PROJECT_NAME=TuneVault
VERSION=2.0.0

# --- Paths (blueprint §38) ---
# Host path to your local music directory
# macOS example: /Users/username/Music
# Windows example: C:\Users\username\Music
# Linux example: /home/username/Music
MUSIC_DIR=./music
# Where downloaded/imported files are staged before entering the library
IMPORT_DIR=/imports
# SQLite database (PostgreSQL profile: postgresql+asyncpg://...)
DATABASE_URL=sqlite:////app/data/tunevault.db
STORAGE_DIR=/app/storage
COVERS_DIR=/app/storage/covers
DOWNLOADS_DIR=/app/storage/downloads

# --- Security / CORS (blueprint §27.3) ---
# Comma-separated list of allowed frontend origins (never use *)
CORS_ORIGINS=http://localhost:5173

# --- External providers (blueprint §25/§26) ---
# MusicBrainz API endpoint
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
# Full User-Agent override; otherwise built from PROJECT_NAME/VERSION.
# MusicBrainz requires a real contact: TuneVault/2.0 (contact@example.com)
MUSICBRAINZ_USER_AGENT=
# Contact email embedded in the default User-Agent
PROVIDER_CONTACT_EMAIL=
# Empty → fingerprint identification is disabled
ACOUSTID_API_KEY=

# --- Identification thresholds (blueprint §8.4) ---
# Decision bands: AUTO_APPLY >= REVIEW >= REJECT
IDENTIFICATION_AUTO_APPLY_THRESHOLD=95
IDENTIFICATION_REVIEW_THRESHOLD=85
IDENTIFICATION_REJECT_THRESHOLD=70

# --- Job queue (blueprint §23) ---
# Reserved for scaling worker replicas (docker compose scale: worker)
MAX_WORKER_CONCURRENCY=2
# Worker poll interval for the SQLite job queue
JOB_POLL_INTERVAL_MS=500

# --- Observability (blueprint §36) ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json = one JSON object per line (production); pretty = human-readable
LOG_FORMAT=json

# --- Release matching preferences (blueprint §10) ---
# prefer_original | prefer_remaster | prefer_high_res | prefer_specific_country | prefer_specific_label
RELEASE_PREFERENCE=prefer_original
RELEASE_PREFERENCE_COUNTRY=
RELEASE_PREFERENCE_LABEL=

# --- Organization safety (blueprint §15/§16) ---
# true = apply engine refuses filesystem writes (default for new installs)
ORGANIZE_DRY_RUN=true
# false disables undo artifacts — undo is then unavailable (§16 Never Destroy)
CREATE_BACKUPS=true

# --- Organization templates (blueprint §17) ---
ORGANIZATION_TEMPLATE={album_artist}/[{year}] {album}/{track:02} - {title}.{ext}
ORGANIZATION_MULTI_DISC_TEMPLATE={album_artist}/[{year}] {album}/CD{disc}/{track:02} - {title}.{ext}

# --- FFmpeg/FFprobe (blueprint §32) ---
# Explicit binary paths when not on PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SECONDS=300